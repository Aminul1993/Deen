# Turns on the admin page at /admin, where the Groq and Pinecone credentials are managed.
# At least 24 characters (shorter ones leave the admin page off). Use a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Redis database holding the credentials, the list of uploaded files and upload progress.
# Use rediss:// for TLS. Keep it secret: it contains the password.
REDIS_URL=redis://default:password@host:6379

# --- Optional ---
# Keep uploaded PDFs (books) in a Vercel Blob store instead of data/books/ on this server's disk.
# The store's read-write token; keep it secret. BLOB_ACCESS must match the store: private (default) or public.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_ACCESS=private
# Read scanned PDF pages with OCR.space (see README: Scanned PDFs). Free key: https://ocr.space/ocrapi/freekey
# One key, or several separated by commas: the next is used when one is refused or asked to slow down.
# OCR_SPACE_API_KEY=
# Drop matches scoring below this value (cosine/dotproduct indexes only). Unset = keep all.
# MIN_RELEVANCE_SCORE=0.78
# LOG_LEVEL=INFO

# --- First start only ---
# Credentials live in the database and are changed on the admin page. If the database has no
# settings yet, these are copied into it once and ignored from then on; remove them afterwards.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
