# Turns on the admin page at /admin, where the Groq and Pinecone credentials are managed.
# At least 24 characters (shorter ones leave the admin page off). Use a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Optional ---
# SQLite database holding the credentials and the list of uploaded files.
# DB_PATH=data/deen.db
# Drop matches scoring below this value (cosine/dotproduct indexes only). Unset = keep all.
# MIN_RELEVANCE_SCORE=0.78
# LOG_LEVEL=INFO

# --- First start only ---
# Credentials live in the database and are changed on the admin page. If the database has no
# settings yet, these are copied into it once and ignored from then on; remove them afterwards.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
